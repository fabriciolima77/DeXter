<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- sem APIs WinRT: roda como .exe comum, sem pacote nem assinatura -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>DeXter</RootNamespace>
    <AssemblyName>DeXter</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- framework-dependent no dia a dia; o pack.ps1 publica self-contained (zip portatil) -->
    <SelfContained>false</SelfContained>
    <ApplicationIcon>..\..\packaging\Assets\DeXter.ico</ApplicationIcon>
    <!-- versao vem do pack.ps1 / tag do GitHub (-p:Version=x.y.z) -->
    <Version>0.5.0</Version>
    <Product>DeXter</Product>
    <Description>Usa o Samsung DeX numa janela do Windows</Description>
    <Copyright>Copyright (C) 2026 fabriciolima77 - GPL-3.0-or-later</Copyright>
  </PropertyGroup>

  <!-- icone do app usado para desenhar o icone da bandeja (com a bolinha de status) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\packaging\Assets\DeXter-256.png" LogicalName="DeXter.Icone.png" />
  </ItemGroup>

  <!-- Servidor do DeX nativo (Java, roda no celular). Compilado por server\build-server.ps1
       (precisa de JDK + Android SDK). Sem ele, o app usa so o modo compatibilidade. -->
  <PropertyGroup>
    <ServidorDir>$(MSBuildThisFileDirectory)..\..\server\</ServidorDir>
    <ServidorJar>$(ServidorDir)dexter-server.jar</ServidorJar>
  </PropertyGroup>
  <ItemGroup>
    <ServidorFontes Include="$(ServidorDir)src\**\*.java" />
  </ItemGroup>

  <Target Name="CompilarServidor" BeforeTargets="Build" Inputs="@(ServidorFontes)" Outputs="$(ServidorJar)"
          Condition="'$(PularServidor)' != 'true'">
    <Message Importance="high" Text="Compilando o servidor do DeX nativo (server\build-server.ps1)..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(ServidorDir)build-server.ps1&quot;"
          ContinueOnError="true" />
    <Warning Condition="!Exists('$(ServidorJar)')"
             Text="dexter-server.jar nao foi gerado (falta JDK ou Android SDK?). O DeXter vai usar so o modo compatibilidade." />
  </Target>

  <Target Name="CopiarServidor" AfterTargets="Build" DependsOnTargets="CompilarServidor" Condition="Exists('$(ServidorJar)')">
    <Copy SourceFiles="$(ServidorJar)" DestinationFolder="$(OutDir)server" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublicarServidor" AfterTargets="Publish" Condition="Exists('$(ServidorJar)')">
    <Copy SourceFiles="$(ServidorJar)" DestinationFolder="$(PublishDir)server" SkipUnchangedFiles="true" />
  </Target>

  <!-- scrcpy + adb embutidos: o build baixa o pacote oficial do scrcpy para vendor\ (uma vez)
       e copia para scrcpy\ ao lado do exe (build e publish). Para trocar de versao, mude ScrcpyVersion. -->
  <PropertyGroup>
    <ScrcpyVersion>4.1</ScrcpyVersion>
    <ScrcpyNome>scrcpy-win64-v$(ScrcpyVersion)</ScrcpyNome>
    <ScrcpyUrl>https://github.com/Genymobile/scrcpy/releases/download/v$(ScrcpyVersion)/$(ScrcpyNome).zip</ScrcpyUrl>
    <VendorDir>$(MSBuildThisFileDirectory)..\..\vendor\</VendorDir>
    <ScrcpyDir>$(VendorDir)$(ScrcpyNome)\</ScrcpyDir>
  </PropertyGroup>

  <Target Name="BaixarScrcpy" BeforeTargets="Build" Condition="!Exists('$(ScrcpyDir)scrcpy.exe')">
    <Message Importance="high" Text="Baixando $(ScrcpyNome) ($(ScrcpyUrl))..." />
    <DownloadFile SourceUrl="$(ScrcpyUrl)" DestinationFolder="$(VendorDir)" Retries="2" />
    <Unzip SourceFiles="$(VendorDir)$(ScrcpyNome).zip" DestinationFolder="$(VendorDir)" OverwriteReadOnlyFiles="true" />
    <Delete Files="$(VendorDir)$(ScrcpyNome).zip" />
    <Error Condition="!Exists('$(ScrcpyDir)scrcpy.exe')"
           Text="scrcpy.exe nao encontrado em $(ScrcpyDir) depois de extrair. Confira o nome da pasta dentro do zip." />
  </Target>

  <Target Name="CopiarScrcpy" AfterTargets="Build" DependsOnTargets="BaixarScrcpy">
    <ItemGroup>
      <ArquivosScrcpy Include="$(ScrcpyDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ArquivosScrcpy)"
          DestinationFiles="@(ArquivosScrcpy->'$(OutDir)scrcpy\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublicarScrcpy" AfterTargets="Publish" DependsOnTargets="BaixarScrcpy">
    <ItemGroup>
      <ArquivosScrcpyPub Include="$(ScrcpyDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ArquivosScrcpyPub)"
          DestinationFiles="@(ArquivosScrcpyPub->'$(PublishDir)scrcpy\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
