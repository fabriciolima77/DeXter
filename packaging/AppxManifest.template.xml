<?xml version="1.0" encoding="utf-8"?>
<!--
  Modelo do manifesto do pacote. Os scripts trocam os marcadores __...__:
    __NOME__        identidade do pacote (DeXter; DeXter.Dev no modo desenvolvedor)
    __PUBLICADOR__  assunto do certificado (precisa ser igual ao Subject do .cer usado para assinar)
    __VERSAO__      x.y.z.0
    __TITULO__      nome exibido (DeXter; "DeXter (dev)" no modo desenvolvedor)
    __ALIAS__       comando no terminal (dexter.exe; dexter-dev.exe no modo desenvolvedor)
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 desktop desktop4 rescap">

  <Identity Name="__NOME__" Publisher="__PUBLICADOR__" Version="__VERSAO__" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>__TITULO__</DisplayName>
    <PublisherDisplayName>fabriciolima77</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Usa o Samsung DeX numa janela do Windows. Projeto open source (GPL-3.0), sem afiliacao com a Samsung.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-br" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="DeXter.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="__TITULO__"
                          Description="Usa o Samsung DeX numa janela do Windows"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- comando no terminal: precisa ser usado (ou o menu Iniciar) para o app ter identidade de pacote -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="DeXter.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="__ALIAS__" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <!-- "Iniciar com o Windows" (menu da bandeja). Comeca desligado; o usuario liga pelo menu. -->
        <desktop:Extension Category="windows.startupTask" Executable="DeXter.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DeXterStartup" Enabled="false" DisplayName="__TITULO__" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
